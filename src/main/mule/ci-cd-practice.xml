				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": "Hello world ci-cd"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="01091148-534c-4616-b1bb-b62b7e9d675c" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": " ci cd successfully run"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
